# Conexion a PostgreSQL por variables de entorno (docker-compose.yml las
# define; los valores despues de ":" son solo para desarrollo local).
spring.datasource.url=jdbc:postgresql://${DB_HOST:localhost}:${DB_PORT:5434}/${DB_NAME:{{ db_name }}}
spring.datasource.username=${DB_USER:{{ db_user }}}
spring.datasource.password=${DB_PASSWORD:{{ db_pass }}}

# "update": Hibernate crea las tablas que falten y agrega columnas nuevas,
# SIN borrar datos al reiniciar (antes era "create", que vaciaba la base en
# cada arranque). Para empezar de cero: DDL_AUTO=create.
spring.jpa.hibernate.ddl-auto=${DDL_AUTO:update}
spring.jpa.show-sql=${SHOW_SQL:false}
spring.jpa.properties.hibernate.format_sql=true

# Bolivia: UTC-04:00 fijo, sin horario de verano. Se fuerza tanto en
# Jackson (serializacion JSON de fechas) como en la conexion JDBC
# (interpretacion de TIMESTAMPTZ), para que un mismo instante se muestre
# igual sin importar en que zona horaria corra el servidor/contenedor.
spring.jackson.time-zone=America/La_Paz
spring.jpa.properties.hibernate.jdbc.time_zone=America/La_Paz
# Fechas como texto ISO ("2026-11-09"), no como arreglos [2026,11,9].
spring.jackson.serialization.write-dates-as-timestamps=false

server.port=8090
