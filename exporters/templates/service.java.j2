    private List<{{ t.class_name }}> findAll{{ t.class_name }}(List<Long> ids, String field) {
        if (ids == null || ids.isEmpty()) return new ArrayList<>();
        List<{{ t.class_name }}> found = new ArrayList<>({{ t.repo_var }}.findAllById(ids));
        Set<Long> distinct = new HashSet<>(ids);
        if (found.size() != distinct.size()) {
            Set<Long> missing = new TreeSet<>(distinct);
            found.forEach(x -> missing.remove(x.getId()));
            throw new BadRequestException(field + ": no existe {{ t.class_name }} con id " + missing);
        }
        return found;
    }
