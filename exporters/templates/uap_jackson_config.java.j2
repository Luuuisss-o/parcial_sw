package com.test.uap;

import org.springframework.boot.autoconfigure.jackson.Jackson2ObjectMapperBuilderCustomizer;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;

import java.util.TimeZone;

/**
 * Fuerza America/La_Paz en Jackson, ademas de spring.jackson.time-zone en
 * application.properties.
 *
 * Es un *customizer* del ObjectMapper que arma Spring Boot, no un
 * ObjectMapper propio: antes se definia un `new ObjectMapper()` @Primary,
 * que reemplazaba al de Spring y perdia sus modulos (fechas java.time,
 * Optional). Resultado: crear algo con un campo LocalDate daba 500 y
 * GET /{id} devolvia {"present": true} en vez del registro.
 */
@Configuration
public class JacksonTimeZoneConfig {

    @Bean
    public Jackson2ObjectMapperBuilderCustomizer laPazTimeZone() {
        return builder -> builder.timeZone(TimeZone.getTimeZone("America/La_Paz"));
    }
}
